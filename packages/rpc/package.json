{
  "name": "@leadflow/rpc",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --no-dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --no-dts --watch",
    "gen": "node src/codegen.cjs",
    "test": "vitest run",
    "check-types": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "pino": "^10.3.1",
    "@bufbuild/protobuf": "^2.12.0"
  },
  "devDependencies": {
    "@leadflow/tsconfig": "*",
    "ts-proto": "^2.11.6",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
