# Secrets for the local docker-compose demo. Copy to `.env`.
# Every default is demo-only — generate real values (e.g. `openssl rand -hex 32`)
# for anything that is not your laptop.

MYSQL_ROOT_PASSWORD=leadflow-root
MYSQL_PASSWORD=leadflow
MINIO_ROOT_USER=leadflow
MINIO_ROOT_PASSWORD=leadflow-minio

# Shared service-to-service token (x-service-token) and user JWT signing key
SERVICE_TOKEN=demo-service-token-change-me-0123456789
JWT_SECRET=demo-jwt-secret-change-me-0123456789abcdef

# lead-ingestion webhook secrets (the simulator signs with the same values)
FB_APP_SECRET=demo-fb-app-secret
FB_VERIFY_TOKEN=demo-fb-verify-token
GOOGLE_FORMS_SECRET=demo-google-forms-secret
OAUTH_STATE_SECRET=demo-oauth-state-secret-change-me-0123456789

# WhatsApp transport (fake in the demo)
WA_TRANSPORT_SECRET_KEY=demo-wa-transport-secret
WA_WEBHOOK_SECRET=demo-wa-webhook-secret

# Agents: `fake` runs without keys; set `anthropic` + ANTHROPIC_API_KEY to use Claude
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=

LOG_LEVEL=info
