# Agents service. Copy to .env and fill in; .env is git-ignored.

PORT=3020
NODE_ENV=development
LOG_LEVEL=info

# Shared service-to-service secret: required on inbound x-service-token, and
# sent on every call to the gateway.
SERVICE_TOKEN=change-me

# Dedicated MySQL database for this service.
DB_HOST=localhost
DB_PORT=3306
DB_USER=agents
DB_PASSWORD=change-me
DB_NAME=agents

# LLM vendor: anthropic | gemini | fake. `fake` needs no key and gives a
# deterministic demo reply, for running the stack offline.
LLM_PROVIDER=anthropic

# Required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high
# Server-side refusal fallback (beta). Set false on models/platforms without it.
ANTHROPIC_REFUSAL_FALLBACK=true

# Required when LLM_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Background agent runs executing at once, and how many may wait before
# POST /actions answers 503.
AGENT_CONCURRENCY=4
AGENT_QUEUE_LIMIT=1000

# Gateway base URL: the agent's only way to reach a channel.
GATEWAY_URL=http://localhost:3000

# Comma-separated https URL prefixes (each ending in /) that
# send_whatsapp_attachment may link to. {businessId} is replaced with the
# tenant, confining each tenant to its own files. Empty disables attachments.
ATTACHMENT_URL_PREFIXES=https://files.example.com/tenants/{businessId}/
