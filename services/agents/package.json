{
  "name": "@leadflow/agents",
  "version": "1.0.0",
  "description": "LLM agent service: an AI receptionist that answers customers through the gateway, and an unattended onboarding parser",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "build": "node ../../scripts/build-service.mjs src/main.ts",
    "dev": "tsx watch --conditions=development src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "eval:onboard": "tsx scripts/onboard-eval/run.ts"
  },
  "imports": {
    "#core/*": "./src/core/*.ts",
    "#config/*": "./src/config/*.ts",
    "#modules/*": "./src/modules/*.ts",
    "#dispatchers/*": "./src/dispatchers/*.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "*",
    "@google/genai": "^2.13.0",
    "@leadflow/shared": "*",
    "axios": "*",
    "dotenv": "^17.2.3",
    "drizzle-orm": "*",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "mysql2": "^3.20.0",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@leadflow/tsconfig": "file:../../packages/tsconfig",
    "@types/express": "^5.0.6",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.25.0",
    "eslint": "^10.5.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "typescript-eslint": "^8.61.1"
  }
}
