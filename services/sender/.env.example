# Sender service. Copy to .env for local runs; values below are placeholders.
NODE_ENV=development
LOG_LEVEL=info

# This service's own database (schema: migrations/*.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=sender
DB_PASSWORD=change-me
DB_NAME=sender

# Redis (read by @leadflow/shared for queues and events)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Outgoing email. The demo points at Mailpit (SMTP on 1025, no auth, no TLS).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Leadflow <no-reply@leadflow.test>"
SMTP_SECURE=false

# Deliverability checks before sending email: off | basic (offline) | full (adds DNS lookups)
EMAIL_CHECKS=basic
