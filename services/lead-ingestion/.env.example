# ── Service ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5097
LOG_LEVEL=info

# ── Database (MySQL 8; schema in migrations/*.sql) ───────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=lead_ingestion
DB_PASSWORD=change-me
DB_NAME=lead_ingestion

# ── Redis (read by @leadflow/shared) ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Facebook app ─────────────────────────────────────────────────────────────
FB_APP_ID=000000000000000
FB_APP_SECRET=replace-with-app-secret
# Token you type into the Meta webhook settings; echoed back in the handshake.
FB_VERIFY_TOKEN=replace-with-verify-token
FB_API_VERSION=v22.0
# Point at scripts/mock-graph.ts in the demo; the real API otherwise.
FB_GRAPH_BASE_URL=https://graph.facebook.com
# Must match a redirect URI registered in the Facebook app exactly.
FB_REDIRECT_URI=http://localhost:5097/fb/auth
FB_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_metadata,pages_manage_ads,leads_retrieval
# HMAC key for the OAuth state parameter (min 32 chars): openssl rand -hex 32
OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters

# ── Google Forms relay ───────────────────────────────────────────────────────
# Shared secret the relay signs each submission body with (x-leadflow-signature).
GOOGLE_FORMS_SECRET=replace-with-google-forms-secret
# Optional hidden field that only bots fill in.
GOOGLE_HONEYPOT_FIELD=website_confirm
GOOGLE_REPLAY_WINDOW_MS=900000
GOOGLE_RATE_LIMIT=30
GOOGLE_RATE_WINDOW_MS=60000

# ── Delivery target: gateway POST /internal/leads ────────────────────────────
GATEWAY_URL=http://localhost:3000
# Shared service-to-service secret (min 16 chars); also guards GET /fb/connect.
SERVICE_TOKEN=replace-with-shared-service-token

# ── Demo scripts only (scripts/simulate-webhooks.ts) ─────────────────────────
INGESTION_URL=http://localhost:5097
FB_PAGE_ID=100000000000001
DEMO_USER_ID=1
DEMO_BUSINESS_ID=1
