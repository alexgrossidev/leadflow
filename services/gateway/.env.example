# ─── gateway environment ─────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env. Validated at startup
# (src/config/env.ts): the process refuses to start on a missing/invalid value.

PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated browser origins allowed by CORS (the frontend).
ALLOWED_ORIGINS=http://localhost:5173

# ─── Secrets ─────────────────────────────────────────────────────────────────
# At least 32 characters each. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
# Shared with lead-ingestion (x-service-token on POST /internal/leads).
SERVICE_TOKEN=change-me-to-a-random-string-of-32-chars-or-more

# ─── Database (MySQL 8) ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=leadflow
DB_PASSWORD=leadflow
DB_NAME=gateway

# ─── Redis (read by @leadflow/shared) ────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── gRPC server (LeadService / CustomerService) ─────────────────────────────
GRPC_LISTEN_ADDR=0.0.0.0:50051

# ─── S3-compatible object storage (Backblaze B2, or MinIO locally) ───────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=leadflow-imports
S3_FORCE_PATH_STYLE=true
