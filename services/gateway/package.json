{
  "name": "@leadflow/gateway",
  "version": "1.0.0",
  "description": "HTTP API and gRPC server for the leadflow platform",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "build": "node ../../scripts/build-service.mjs src/main.ts",
    "dev": "tsx watch --conditions=development src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "check-types": "tsc --noEmit"
  },
  "imports": {
    "#core/*": "./src/core/*.ts",
    "#database/*": "./src/database/*.ts",
    "#modules/*": "./src/modules/*.ts",
    "#config/*": "./src/config/*.ts",
    "#comms/*": "./src/comms/*.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@leadflow/rpc": "file:../../packages/rpc",
    "@leadflow/shared": "file:../../packages/shared",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "drizzle-orm": "*",
    "drizzle-zod": "*",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.17.4",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@leadflow/rpc": "file:../../packages/rpc",
    "@leadflow/shared": "file:../../packages/shared",
    "@leadflow/tsconfig": "file:../../packages/tsconfig",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.25.0",
    "eslint": "^10.5.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "typescript-eslint": "^8.61.1"
  }
}
