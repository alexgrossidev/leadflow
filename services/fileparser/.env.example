NODE_ENV=development
LOG_LEVEL=info

# This service's own MySQL database (migrations/*.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=fileparser
DB_PASSWORD=change-me
DB_NAME=fileparser

# Redis for the job queue (read by @leadflow/shared)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# S3-compatible object storage holding uploaded import files.
# Demo (MinIO): path-style URLs are required.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET=imports
S3_FORCE_PATH_STYLE=true

# Gateway gRPC endpoint that receives BulkInsertCustomers calls
GATEWAY_GRPC_ADDR=localhost:50051
# Per-call deadline for each batch
GRPC_DEADLINE_MS=30000

# Max size of an .xlsx/.xls upload. Spreadsheets are parsed in memory;
# CSV is streamed and not subject to this limit. Default 20 MB.
IMPORT_MAX_BYTES=20971520
