# Automations service. Copy to .env for local runs; values below are placeholders.
NODE_ENV=development
LOG_LEVEL=info

# This service's own database (schema: migrations/*.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=automations
DB_PASSWORD=change-me
DB_NAME=automations

# Redis (read by @leadflow/shared for queues and events)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Gateway gRPC LeadService, used to backfill leads into new automations
GATEWAY_GRPC_ADDR=localhost:50051
