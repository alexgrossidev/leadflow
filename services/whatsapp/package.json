{
  "name": "@leadflow/whatsapp",
  "version": "1.0.0",
  "description": "Per-tenant WhatsApp sessions and outbound message delivery for leadflow",
  "scripts": {
    "build": "node ../../scripts/build-service.mjs src/app.ts",
    "dev": "tsx watch --conditions=development src/app.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "fake-transport": "tsx dev/fake-transport.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@leadflow/shared": "*",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.8.5",
    "mysql2": "^3.22.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {},
  "imports": {
    "#core/*": {
      "types": "./src/core/*.ts",
      "development": "./src/core/*.ts",
      "default": "./dist/core/*.js"
    },
    "#config/*": {
      "types": "./src/config/*.ts",
      "development": "./src/config/*.ts",
      "default": "./dist/config/*.js"
    },
    "#modules/*": {
      "types": "./src/modules/*.ts",
      "development": "./src/modules/*.ts",
      "default": "./dist/modules/*.js"
    },
    "#transport/*": {
      "types": "./src/transport/*.ts",
      "development": "./src/transport/*.ts",
      "default": "./dist/transport/*.js"
    },
    "#workers/*": {
      "types": "./src/workers/*.ts",
      "development": "./src/workers/*.ts",
      "default": "./dist/workers/*.js"
    }
  }
}
