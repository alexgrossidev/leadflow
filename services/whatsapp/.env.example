# whatsapp service. Copy to .env and fill in; never commit .env.
# Generate secrets with: openssl rand -hex 32

NODE_ENV=development
LOG_LEVEL=info
PORT=3012
# Bind address; 0.0.0.0 is required inside a container.
HOST=0.0.0.0

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=whatsapp
DB_PASSWORD=change-me
DB_NAME=whatsapp

# ─── Redis (read by @leadflow/shared) ─────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Secrets (min 16 characters each) ─────────────────────────────────────────
# Required as the x-service-token header on every /sessions route.
SERVICE_TOKEN=replace-with-openssl-rand-hex-32
# Must equal SECRET_KEY of the transport (wppconnect-server or dev/fake-transport.ts).
WA_TRANSPORT_SECRET_KEY=replace-with-openssl-rand-hex-32
# Authenticates webhook callbacks. Configure the transport with
#   WEBHOOK_URL=http://<whatsapp-host>:3012/sessions/callback/<WA_WEBHOOK_SECRET>
WA_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32

# ─── Transport ────────────────────────────────────────────────────────────────
# wppconnect-server, or `npm run fake-transport` (FAKE_WA_PORT, default 21465).
WHATSAPP_SERVER_URL=http://127.0.0.1:21465

# ─── Optional tuning (defaults shown) ─────────────────────────────────────────
# WHATSAPP_QUEUE_ATTEMPTS=5
# WHATSAPP_RETRY_DELAY_MS=5000
# WHATSAPP_WORKER_CONCURRENCY=5
# WHATSAPP_SEND_TIMEOUT_MS=30000
# WHATSAPP_SESSION_HEALTH_INTERVAL_MS=60000
# WHATSAPP_MAX_CONCURRENT_SESSIONS=20
# WHATSAPP_SESSION_MAX_RECONNECT_ATTEMPTS=5
# WHATSAPP_SESSION_INACTIVITY_TIMEOUT_MS=1800000
